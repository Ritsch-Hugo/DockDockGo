DATABASE_URL=postgres://docdockgo_admin:docdockgo@postgres:5432/docdockgo
BIND_ADDR=0.0.0.0:3000
HIGH_LEVEL_URL=http://127.0.0.1:4000/v1/high-level
LLM_DECISION_URL=http://127.0.0.1:3005/v1/decision
RUST_LOG=info,tower_http=info
QUARANTINE_BASE=../Proxy/quarantaine
CACHE_BASE=../Proxy/cache

# ── Timeouts (en secondes) ───────────────────────────────────────────────────
# Timeout appel scanner haut-niveau Gemini
HL_TIMEOUT_SECS=60
# Timeout attente réponse LLM-decision (doit être > HL_TIMEOUT_SECS + temps scan)
LLM_DECISION_TIMEOUT_SECS=120

# ── Seuils décision scanner haut-niveau ─────────────────────────────────────
# Score >= HL_ALLOW_THRESHOLD → ALLOW directement (sans scan full)
HL_ALLOW_THRESHOLD=90
# Score < HL_DENY_THRESHOLD  → DENY directement
HL_DENY_THRESHOLD=30

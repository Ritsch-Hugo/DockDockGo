  "query": "SELECT uuid, repository, tag, ip_client, decision_final, started_at\n         FROM pulls\n         WHERE ip_client = ANY($1)\n           AND (LOWER(repository) LIKE $2 OR LOWER(tag) LIKE $2 OR LOWER(ip_client) LIKE $2)\n         ORDER BY started_at DESC LIMIT 10",

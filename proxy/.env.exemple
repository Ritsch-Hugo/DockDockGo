DATABASE_URL=postgres://docdockgo_admin:docdockgo@localhost:5432/docdockgo

# Taille max d'un blob (2 Go)
MAX_BLOB_SIZE=2147483648

# Pulls simultanés max
MAX_CONCURRENT_PULLS=200

# Timeout contexte pull (en secondes)
CONTEXT_TIMEOUT=360

# URL de l'orchestrateur
ORCH_URL=http://127.0.0.1:3000/v1/decision

# Timeout drain après SIGTERM (doit être < timeout SIGKILL Kubernetes)
SHUTDOWN_DRAIN_TIMEOUT_SECS=0

QUARANTINE_BASE=/app/quarantaine
CACHE_BASE=/app/cache

# Timeout appel orchestrateur (en secondes)
ORCH_TIMEOUT_SECS=300

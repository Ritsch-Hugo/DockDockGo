DATABASE_URL=postgres://docdockgo_admin:docdockgo@localhost:5432/docdockgo

#Blob 2Go Max
MAX_BLOB_SIZE=2147483648 

#Concurrent Pull
MAX_CONCURRENT_PULLS=200

#Timout (en sec)
CONTEXT_TIMEOUT=360 

#Url Orchestrateur
ORCH_URL=http://127.0.0.1:3000/v1/decision

#Timout pour finir pull après SIGTERM | Doit etre < Timeout SIGKILL Kubernetes
SHUTDOWN_DRAIN_TIMEOUT_SECS=0

QUARANTINE_BASE=/app/quarantaine
CACHE_BASE=/app/cache

#Timeout appel orchestrateur (en sec)
ORCH_TIMEOUT_SECS=120
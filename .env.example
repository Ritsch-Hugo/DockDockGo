# ── Base de données ───────────────────────────────────────────────────────────

# URL PostgreSQL pour la persistence des CVE alerts (optionnel)
# Sans cette variable, les alertes sont perdues au redémarrage du service
DATABASE_URL=postgres://docdockgo_admin:docdockgo@localhost:5432/docdockgo

# ── Réseau ────────────────────────────────────────────────────────────────────

# Port d'écoute du service
PORT=3020

# URL de l'endpoint de notification du dashboard (laisser vide pour désactiver)
DASHBOARD_URL=http://localhost:3010/notifications

# ── Polling OSV ───────────────────────────────────────────────────────────────

# Intervalle entre deux polls OSV en secondes
POLL_INTERVAL_SECS=60

# ── Whitelist ─────────────────────────────────────────────────────────────────

# Chemin vers la whitelist TOML (sans extension)
# config/whitelist → lit config/whitelist.toml
WHITELIST_PATH=config/whitelist

# ── SBOMs ────────────────────────────────────────────────────────────────────

# Répertoire où sont stockés les SBOMs générés par Syft (un fichier JSON par image)
SBOM_DIR=sboms

# Chemin ou nom de l'exécutable Syft
SYFT_BIN=syft

# Intervalle de régénération complète des SBOMs en secondes (0 = désactivé)
# Par défaut : 86400 (24 h)
SBOM_REFRESH_INTERVAL_SECS=86400

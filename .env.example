# Port d'écoute du service
PORT=3020

# URL de l'endpoint de notification du dashboard (laisser vide pour désactiver)
DASHBOARD_URL=http://localhost:3010/notifications

# Intervalle entre deux polls OSV en secondes
POLL_INTERVAL_SECS=60

# Chemin vers la whitelist (sans extension, config/whitelist => config/whitelist.toml)
WHITELIST_PATH=config/whitelist

# Port HTTP du scanner CVE                                                    
# En production (Kubernetes), injecter via les variables d'environnement du pod                                                                           
PORT=3002
                                                                            
# Niveau de log : error | warn | info | debug | trace                         
# Peut aussi être filtré par module : scanner_cve=debug,axum=warn
RUST_LOG=info                                                                 
                
# Nombre max de requêtes par seconde acceptées (token bucket global)          
RATE_LIMIT_RPS=10
                                                                            
# Nombre max de scans Trivy simultanés (au-delà → 429)                        
MAX_CONCURRENT_SCANS=4
                                                                            
# Timeout du scan Trivy en secondes (défaut : 300)
TRIVY_TIMEOUT_SECS=300

# Utiliser la DB Trivy pré-téléchargée par trivy-db-init sans tentative de MAJ réseau
# Mettre à true en production / docker-compose (trivy-db-init s'occupe du téléchargement)
TRIVY_SKIP_DB_UPDATE=true
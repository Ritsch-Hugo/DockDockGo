# Port HTTP du scanner CVE
PORT=3002

# Niveau de log : error | warn | info | debug | trace
RUST_LOG=info

# Nombre max de requêtes par seconde (token bucket global)
RATE_LIMIT_RPS=10

# Nombre max de scans Trivy simultanés (au-delà → 429)
MAX_CONCURRENT_SCANS=4

# Timeout du scan Trivy en secondes
TRIVY_TIMEOUT_SECS=300

# Utiliser la DB Trivy pré-téléchargée sans tentative de MAJ réseau
TRIVY_SKIP_DB_UPDATE=true

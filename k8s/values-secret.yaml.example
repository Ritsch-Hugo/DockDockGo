# Copier ce fichier en values-secret.yaml et remplir les valeurs.
# values-secret.yaml est gitignore — ne jamais le committer.

postgres:
  credentials:
    password: docdockgo  # changer en prod

scannerHautNiveau:
  geminiApiKey: "VOTRE_CLE_GEMINI"

llmManager:
  openrouterApiKey: "VOTRE_CLE_OPENROUTER"

dashboard:
  config:
    allowedIps: "192.168.1.100,10.0.0.1"
  oidc:
    issuer: "https://votre-instance.zitadel.cloud"
    clientId: "VOTRE_CLIENT_ID"
    redirectUri: "http://<node-ip>:3010/callback"
    postLogoutRedirectUri: "http://<node-ip>:3010/logged-out"

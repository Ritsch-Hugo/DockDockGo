{
  "meta": { "image_ref": "example/fs-secret:latest" },
  "config": {
    "user": "1000",
    "env": { "APP_ENV": "prod" },
    "labels": {
      "org.opencontainers.image.source": "https://github.com/example/fs-secret",
      "org.opencontainers.image.revision": "abc123"
    },
    "entrypoint": ["/app/server"],
    "cmd": [],
    "working_dir": "/app",
    "exposed_ports": [],
    "volumes": []
  },
  "fs_paths": [
    "/app/.env",
    "/root/.ssh/id_rsa",
    "/etc/passwd"
  ]
}

# Port d'écoute du serveur HTTP
PORT=3001

 # Rate limiting : intervalle minimum entre deux requêtes (en secondes)
 # Ex: 1 = 1 requête par seconde maximum par IP
RATE_LIMIT_PER_SECOND=1

 # Rate limiting : nombre maximum de requêtes en rafale autorisées par IP
RATE_LIMIT_BURST=10

# Base de la quarantaine partagée (volume Docker monté sur /quarantaine)
# Permet de résoudre les blobs layer sans path envoyés par mcp-tools-server
QUARANTINE_BASE=/quarantaine